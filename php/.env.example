# Remote PostgreSQL Database Configuration for PHP (Neon / CockroachDB / Supabase)

# Option 1: Full Connection URL
DATABASE_URL=postgresql://user:password@ep-your-subdomain.neon.tech/neondb?sslmode=require

# Option 2: Discrete connection parameters
DB_HOST=ep-your-subdomain.neon.tech
DB_PORT=5432
DB_NAME=neondb
DB_USER=neon_user
DB_PASSWORD=your_secure_password
